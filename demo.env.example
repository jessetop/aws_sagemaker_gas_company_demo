# Single source of config for the demo scripts.
#
# COPY THIS TO demo.env AND EDIT. demo.env is gitignored so your account
# details never land in a public repo.
#
#   cp demo.env.example demo.env
#   # edit the four values below
#   python 00-setup/preflight.py        # confirms it's wired up correctly
#
# Resolution order (highest wins):
#   1. a --flag passed on the command line   (one-off override)
#   2. an OS environment variable of the same name
#   3. this file
#   4. a built-in fallback in shared/config.py
#
# The bucket defaults to roi-smdemo-<account>-<region> if you leave
# SMDEMO_BUCKET unset.

SMDEMO_ACCOUNT=000000000000
SMDEMO_REGION=us-east-1
SMDEMO_PROFILE=default
SMDEMO_BUCKET=
SMDEMO_ROLE_ARN=arn:aws:iam::000000000000:role/roi-smdemo-exec-role

# Prefix for every named AWS resource the demos create (jobs, feature groups,
# endpoints, pipelines, experiments). cleanup/ reads this too, so renaming here
# keeps teardown in step with creation instead of drifting apart.
SMDEMO_PREFIX=roi-smdemo-gas
