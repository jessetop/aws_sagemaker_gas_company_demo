# Single source of config for the SageMaker demo scripts.
#
# Resolution order (highest wins):
#   1. a --flag passed on the command line   (one-off override)
#   2. an OS environment variable of the same name
#   3. this file
#   4. a built-in fallback in shared/config.py
#
# Change the account/region here once and every script follows. The bucket
# defaults to roi-smdemo-<account>-<region> if you leave SMDEMO_BUCKET unset.
SMDEMO_ACCOUNT=029331796573
SMDEMO_REGION=us-east-1
SMDEMO_PROFILE=roitraining
SMDEMO_BUCKET=roi-smdemo-029331796573-us-east-1
SMDEMO_ROLE_ARN=arn:aws:iam::029331796573:role/roi-smdemo-exec-role
