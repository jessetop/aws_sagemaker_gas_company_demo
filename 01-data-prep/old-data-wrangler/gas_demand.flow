    {
      "node_id": "a1000000-0000-4000-8000-000000000005",
      "type": "TRANSFORM",
      "operator": "sagemaker.spark.custom_pandas_0.1",
      "parameters": {
        "code": "# Table is available as variable `df`\n# GHCN stores temperature as an INTEGER in TENTHS of a degree C.\n# 390 means 39.0 C. Forget this and every number is 10x wrong.\ndf['temp_max_c'] = df['value_tenths_c'] / 10.0\n\n# GHCN DATE is the STRING \"20240115\", not a date. Parse it explicitly.\nimport pandas as pd\ndf['obs_date'] = pd.to_datetime(df['DATE'].astype(str), format='%Y%m%d', errors='coerce')\n\n# Q_FLAG is populated ONLY when a reading failed quality control,\n# so \"good data\" means the flag is empty.\ndf = df[df['Q_FLAG'].isna() | (df['Q_FLAG'].astype(str).str.strip() == '')]\n"
      },
      "inputs": [
        {
          "name": "df",
          "node_id": "a1000000-0000-4000-8000-000000000004",
          "output_name": "default"
        }
      ],
      "outputs": [{ "name": "default" }]
    },
