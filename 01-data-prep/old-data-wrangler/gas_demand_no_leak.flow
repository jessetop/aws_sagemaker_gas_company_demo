    {
      "node_id": "a1000000-0000-4000-8000-000000000003",
      "type": "TRANSFORM",
      "operator": "sagemaker.spark.custom_pandas_0.1",
      "name": "clean GHCN",
      "parameters": {
        "code": "# Table is available as variable `df`\nimport pandas as pd\n\n# 1. Drop rows missing the fields everything else depends on.\ndf = df.dropna(subset=['ID', 'DATE', 'DATA_VALUE'])\n\n# 2. Q_FLAG is populated ONLY when a reading FAILED quality control,\n#    so \"good data\" means the flag is empty.\ndf = df[df['Q_FLAG'].isna() | (df['Q_FLAG'].astype(str).str.strip() == '')]\n\n# 3. DATA_VALUE is an INTEGER in TENTHS of a degree C.\n#    390 means 39.0 C. Miss this and every number is 10x wrong.\ndf['temp_max_c'] = df['DATA_VALUE'] / 10.0\n\n# 4. DATE is the STRING \"20240115\", not a date. Parse it explicitly --\n#    a silent cast returns NaT and quietly deletes rows.\ndf['obs_date'] = pd.to_datetime(df['DATE'].astype(str), format='%Y%m%d', errors='coerce')\ndf['obs_month'] = df['obs_date'].dt.month\n\n# 5. THE TARGET. 65 F (18.33 C) is the utility industry's heating\n#    base temperature. If the day's HIGH never reached it, that is a\n#    heating day -- the days the gas utility actually has to supply gas for.\ndf['heating_day'] = (df['temp_max_c'] < 18.33).astype(int)\n\ndf = df[['ID', 'obs_date', 'obs_month', 'temp_max_c', 'heating_day']]\n"
      },
      "inputs": [
        {
          "name": "df",
          "node_id": "a1000000-0000-4000-8000-000000000002",
          "output_name": "default"
        }
      ],
      "outputs": [
        {
          "name": "default"
        }
      ]
    },
