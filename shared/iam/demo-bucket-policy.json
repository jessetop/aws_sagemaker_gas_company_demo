{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowUnifiedStudioProjectRead",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::000000000000:role/service-role/AmazonSageMakerAdminIAMExecutionRole"
      },
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::YOUR-BUCKET-NAME",
        "arn:aws:s3:::YOUR-BUCKET-NAME/*"
      ]
    }
  ]
}
